{
  "name": "lighthouse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H localhost",
    "build": "npm run build:next",
    "build:next": "next build",
    "start": "next start",
    "postinstall": "python3 scripts/sync-agent-skills.py --prune",
    "prepare": "husky",
    "onboard:check": "tsx scripts/onboarding/check.ts",
    "agent:lsp:install": "node scripts/agent/setup-lsp-mcp.mjs",
    "agent:lsp:check": "node scripts/agent/setup-lsp-mcp.mjs --check",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.typecheck.json",
    "dup:check": "jscpd --config .jscpd.json",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "guard:escapes": "node scripts/quality/check-escapes.mjs",
    "glossary": "tsx scripts/glossary/cli.ts",
    "guard:glossary": "npm run glossary -- check",
    "deps:boundaries": "dependency-cruiser --config .dependency-cruiser.cjs app",
    "deps:lock": "npm install --package-lock-only --ignore-scripts --dry-run",
    "deps:security": "npm audit --audit-level=high --omit=dev",
    "deps:tree": "npm ls --depth=0",
    "deps:unused": "npx knip --reporter compact",
    "deps:audit": "npm run deps:lock && npm run deps:tree && npm run deps:security && npm run deps:unused",
    "guard:korean": "node scripts/quality/check-hardcoded-korean.mjs",
    "guard:ledger-citations": "tsx scripts/quality/check-ledger-test-citations.mjs",
    "guard:repository-seam": "node scripts/quality/check-repository-db-seam.mjs",
    "guard:least-authority-boundaries": "node scripts/architecture-fitness/check-least-authority-boundaries.mjs",
    "guard:route-deadline": "node scripts/quality/check-route-deadline-budget.mjs",
    "guard:route-ingress": "node scripts/quality/check-route-ingress-policy.mjs",
    "guard:api-response-contract": "node scripts/quality/check-api-response-contract.mjs",
    "guard:operational-boundaries": "node scripts/quality/check-operational-boundary-register.mjs",
    "guard:inline-analysis-cache-contract": "node scripts/quality/check-inline-analysis-cache-contract.mjs",
    "guard:external-http-gateway": "node scripts/quality/check-external-http-gateway.mjs",
    "guard:auth-resolver-write-free": "node scripts/quality/check-auth-resolver-write-free.mjs",
    "guard:auth-hot-path": "node scripts/quality/check-auth-hot-path.mjs",
    "guard:landing-auth-source-boundary": "npm run deps:boundaries && node scripts/quality/check-landing-auth-source-boundary.mjs",
    "guard:interactive-hot-path": "node scripts/quality/check-interactive-hot-path.mjs",
    "guard:product-owned-navigation": "node scripts/quality/check-product-owned-navigation.mjs",
    "guard:ai-generation-gateway": "node scripts/quality/check-ai-generation-gateway.mjs",
    "guard:search-first-paint-no-db": "node scripts/quality/check-search-first-paint-no-db.mjs",
    "guard:supabase-migration-transaction-safety": "node scripts/quality/check-supabase-migration-transaction-safety.mjs",
    "guard:state-boundaries": "node scripts/architecture-fitness/check-state-boundaries.mjs",
    "guard:search-condition-url-budget": "node scripts/architecture-fitness/check-search-condition-url-budget.mjs",
    "guard:skills": "python3 scripts/sync-agent-skills.py --check",
    "guard:gate-parity": "node scripts/quality/check-gate-parity.mjs",
    "guard:lane-freshness": "node scripts/quality/check-lane-freshness.mjs",
    "gate:snapshot": "node scripts/quality/refresh-branch-protection-snapshot.mjs",
    "skill:routing-eval": "node scripts/quality/check-skill-routing-corpus.mjs",
    "architecture-fitness:validate": "node scripts/architecture-fitness/validate-reviews.mjs",
    "architecture-fitness:check-publication": "node scripts/architecture-fitness/check-observation-publication.mjs",
    "architecture-fitness:review": "node scripts/architecture-fitness/lighthouse-adapter.mjs",
    "architecture-fitness:attest": "node scripts/architecture-fitness/authoritative-attestation.mjs attest",
    "architecture-fitness:verify": "node scripts/architecture-fitness/authoritative-attestation.mjs verify",
    "architecture-fitness:impact": "node scripts/architecture-fitness/impact-advisory.mjs",
    "architecture-fitness:advisory": "npm run architecture-fitness:review -- --all --check",
    "architecture-fitness:verdict": "npm run architecture-fitness:review -- --all --check --verdict-exit",
    "architecture-fitness:held-out": "node scripts/architecture-fitness/run-held-out-corpus.mjs",
    "review-closeout:check": "node scripts/quality/check-review-closeout.mjs",
    "quality:pr": "npm run review-closeout:check -- --base origin/main",
    "lint": "eslint . --max-warnings=0",
    "lint:cached": "eslint . --cache --cache-location .next/cache/eslint --max-warnings=0",
    "mc:status": "tsx scripts/mission-control/mc-status.ts",
    "mc:review-retention": "tsx scripts/mission-control/mc-review-retention-report.ts",
    "mc:next": "tsx scripts/mission-control/mc-next.ts",
    "mc:validate-cair": "tsx scripts/mission-control/mc-validate-cair.ts",
    "mc:cair-inventory": "tsx scripts/mission-control/mc-validate-cair.ts --all",
    "mc:validate-story-chain": "tsx scripts/mission-control/mc-validate-story-chain.ts",
    "mc:validate-events": "tsx scripts/mission-control/mc-validate-events.ts",
    "mc:event-impact": "tsx scripts/mission-control/mc-event-impact.ts",
    "mc:audit-surface": "tsx scripts/mission-control/mc-audit-surface.ts",
    "mc:audit-story-surface": "tsx scripts/mission-control/mc-audit-story-surface.ts",
    "mc:check-message-registry": "tsx scripts/mission-control/check-message-registry-contract.ts",
    "mc:trace-ledger": "tsx scripts/mission-control/mc-trace-ledger.ts",
    "mc:check-critical-findings": "tsx scripts/mission-control/mc-check-critical-findings.ts",
    "contract-maps:check": "tsx scripts/contract-maps/check.ts",
    "pk:start": "tsx scripts/project-knowledge/start.ts",
    "pk:preprompt": "tsx scripts/project-knowledge/preprompt.ts",
    "pk:checkpoint": "tsx scripts/project-knowledge/checkpoint.ts",
    "pk:remember": "tsx scripts/project-knowledge/remember.ts",
    "pk:review": "tsx scripts/project-knowledge/review.ts",
    "pk:recall": "tsx scripts/project-knowledge/recall.ts",
    "pk:log": "tsx scripts/project-knowledge/log.ts",
    "pk:validate": "tsx scripts/project-knowledge/validate.ts",
    "project-status": "node scripts/project-status/checkpoint.mjs",
    "structural-audit:check": "node shared-skills/structural-audit/references/check-topology.mjs",
    "structural-audit:snapshot": "node shared-skills/structural-audit/references/create-snapshot.mjs",
    "eval:term-discovery:capture": "tsx --env-file=.env.local scripts/evals/capture-search-sample.ts",
    "eval:term-discovery": "tsx --env-file=.env.local scripts/evals/search-term-discovery-eval.ts",
    "eval:search-quality": "tsx scripts/search-quality/run.ts",
    "search-quality:build-candidate": "tsx scripts/search-quality/run-attestation.ts build-candidate",
    "search-quality:self-check": "tsx scripts/search-quality/run-attestation.ts self-check",
    "load-smoke": "tsx --env-file=.env.local scripts/load-smoke/run.ts",
    "load-smoke:provider-fixture": "tsx scripts/load-smoke/run-provider-fixture.ts",
    "clean:artifacts": "tsx scripts/local-artifacts/cleanup.ts",
    "lint:fix": "eslint . --fix",
    "lint:report": "mkdir -p coverage/eslint && eslint . --max-warnings=0 --format json --output-file coverage/eslint/report.json",
    "knip": "npm run deps:unused",
    "quality:guards": "npm run guard:escapes && npm run guard:korean && npm run guard:glossary && npm run guard:search-condition-url-budget && npm run guard:search-first-paint-no-db && npm run guard:supabase-migration-transaction-safety && npm run guard:ledger-citations && npm run guard:skills && npm run pk:validate && npm run contract-maps:check && npm run guard:route-deadline && npm run guard:route-ingress && npm run guard:api-response-contract && npm run guard:operational-boundaries && npm run guard:inline-analysis-cache-contract && npm run guard:external-http-gateway && npm run guard:auth-resolver-write-free && npm run guard:auth-hot-path && npm run guard:landing-auth-source-boundary && npm run guard:interactive-hot-path && npm run guard:product-owned-navigation && npm run guard:ai-generation-gateway && npm run guard:repository-seam && npm run guard:least-authority-boundaries && npm run guard:state-boundaries && npm run guard:gate-parity && npm run guard:lane-freshness",
    "quality:commit": "npm run quality:guards && npm run dup:check && npm run mc:validate-story-chain -- --staged && npm run mc:validate-cair -- --staged && npm run mc:validate-events && npm run mc:event-impact -- --staged && npm run mc:audit-surface -- --staged && npm run mc:audit-story-surface -- --staged && npm run mc:check-critical-findings -- --staged && lint-staged",
    "quality:contract": "npm run guard:ledger-citations && npm run mc:validate-story-chain && npm run mc:validate-cair && npm run mc:audit-surface && npm run mc:audit-story-surface && npm run mc:validate-events && npm run mc:event-impact && npm run evidence-ledger:parity && npm run evidence-ledger:dry && npm run mc:check-critical-findings && npm run format:check",
    "quality:fast": "npm run quality:static && npm run test:unit",
    "quality:static": "npm run structural-audit:check && npm run quality:guards && npm run quality:contract && npm run lint:cached && npm run typecheck && npm run dup:check && npm run mc:check-message-registry",
    "quality:audit": "npm run deps:audit",
    "quality:full": "npm run quality:guards && npm run quality:contract && npm run lint:report && npm run typecheck && npm run dup:check && npm run knip && npm run test:coverage && npm run evidence-ledger && npm run mc:check-message-registry && npm run build",
    "evidence-ledger": "tsx scripts/evidence-ledger-run.ts run",
    "evidence-ledger:dry": "tsx scripts/evidence-ledger-run.ts run --dry-run",
    "evidence-ledger:parity": "tsx scripts/evidence-ledger/check-migration-parity.ts",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"**/*.live.test.*\"",
    "test:db:gap-report-concurrency": "tsx scripts/db-integration/run-gap-report-concurrency.ts",
    "db:start:ci": "tsx scripts/db-integration/start-local-supabase-ci.ts",
    "db:stop:ci": "supabase stop --no-backup --project-id lighthouse --yes",
    "test:intent:live": "vitest run app/server/services/__tests__/*intent-qualitative.live.test.ts app/server/services/__tests__/*intent-qualitative.live.test.tsx",
    "test:coverage": "vitest run --coverage",
    "mutation": "stryker run stryker.agent.config.mjs",
    "mutation:agent": "stryker run stryker.agent.config.mjs",
    "mutation:contracts": "stryker run stryker.contracts.config.mjs",
    "mutation:domain": "stryker run stryker.domain.config.mjs",
    "mutation:research-route": "stryker run stryker.research-route.config.mjs",
    "mutation:all": "npm run mutation:agent && npm run mutation:contracts && npm run mutation:domain && npm run mutation:research-route",
    "db:reset:local": "supabase db reset --local --yes",
    "quality:hook": "node scripts/quality/quality-change-scope.mjs --hook",
    "quality:docs": "npm run quality:guards && npm run quality:contract && npm run skill:routing-eval && npm run test:docs",
    "test:docs": "vitest run scripts/quality/__tests__/quality-config-ownership.test.ts scripts/quality/__tests__/quality-profile-consolidation.test.ts scripts/quality/__tests__/check-review-closeout.test.ts scripts/quality/__tests__/check-skill-routing-corpus.test.ts scripts/quality/__tests__/quality-change-scope.test.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.30",
    "@amplitude/unified": "^1.1.3",
    "@google/genai": "^1.41.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.100.0",
    "@types/d3-force": "^3.0.10",
    "ai": "^6.0.97",
    "d3-force": "^3.0.0",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "jsonwebtoken": "^9.0.3",
    "next": "16.2.11",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "yaml": "^2.8.4",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "overrides": {
    "@protobufjs/utf8": "1.1.1",
    "brace-expansion": "5.0.9",
    "minimatch": "10.2.4",
    "nanoid": "3.3.18",
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.3"
    },
    "protobufjs": "7.6.5",
    "qs": "6.15.2",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@next/env": "16.2.11",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.2",
    "dependency-cruiser": "^17.3.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "eslint-plugin-sonarjs": "^4.0.2",
    "github-slugger": "2.0.0",
    "husky": "^9.1.7",
    "jscpd": "^4.0.8",
    "jsdom": "^29.0.1",
    "knip": "^6.0.6",
    "lint-staged": "^16.4.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-to-string": "4.0.0",
    "pg": "^8.22.0",
    "postcss": "^8.5.23",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "string-argv": "^0.3.2",
    "supabase": "^2.101.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "typescript-eslint": "^8.57.2",
    "vitest": "^4.0.18"
  }
}
