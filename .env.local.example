# Supabase
# Local Docker Supabase uses http://127.0.0.1:54321.
# Run `supabase start`, then copy anon/service_role values from `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# Supabase (서버사이드 전용)
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# Gemini (Vercel AI SDK용 — 상위 에이전트)
GOOGLE_GENERATIVE_AI_API_KEY=your-google-api-key

# Gemini (하위 에이전트용 — @google/genai 직접 호출)
GEMINI_API_KEY=your-gemini-api-key

# OpenAI (optional)
OPENAI_API_KEY=your-openai-api-key

# Moonlight Scholar handoff
# Browser token issuance uses NEXT_PUBLIC_MOONLIGHT_SCHOLAR_API_BASE_URL because the
# request must include the user's Moonlight browser session cookie.
MOONLIGHT_SCHOLAR_API_BASE_URL=https://api.themoonlight.io
NEXT_PUBLIC_MOONLIGHT_SCHOLAR_API_BASE_URL=https://api.themoonlight.io
MOONLIGHT_SCHOLAR_AUTH_JWT_SECRET=your-shared-local-scholar-secret
MOONLIGHT_SCHOLAR_AUTH_TOKEN_ISSUER=moonlight
MOONLIGHT_SCHOLAR_AUTH_TOKEN_AUDIENCE=moonlight-scholar
